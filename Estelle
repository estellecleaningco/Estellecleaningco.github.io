font-size: 26px;
font-weight: 600;
color: var(–cream);
font-style: italic;
}

.modal-close {
background: none;
border: 1px solid rgba(184,134,11,0.3);
color: var(–gold);
width: 36px;
height: 36px;
font-size: 18px;
cursor: pointer;
