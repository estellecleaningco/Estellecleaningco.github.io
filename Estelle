}

/* ── MODAL ── */
.modal-overlay {
position: fixed;
inset: 0;
background: rgba(26,26,24,0.85);
backdrop-filter: blur(8px);
z-index: 500;
display: flex;
align-items: center;
justify-content: center;
padding: 24px;
opacity: 0;
pointer-events: none;
transition: opacity 0.3s;
}

.modal-overlay.active {
opacity: 1;
pointer-events: all;
}

.modal {
background: var(–cream);
width: 100%;
max-width: 620px;
max-height: 90vh;
overflow-y: auto;
position: relative;
transform: translateY(24px);
transition: transform 0.3s;
}

.modal-overlay.active .modal { transform: translateY(0); }

.modal-header {
background: var(–ink);
padding: 28px 36px;
display: flex;
align-items: flex-start;
justify-content: space-between;
gap: 16px;
position: sticky;
top: 0;
z-index: 10;
}

.modal-header-text {}

.modal-eyebrow {
font-size: 9px;
letter-spacing: 3px;
text-transform: uppercase;
color: var(–gold);
margin-bottom: 6px;
}

.modal-title {
