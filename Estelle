.form-success {
display: none;
text-align: center;
padding: 48px 24px;
}

.form-success.show { display: block; }
.form-success-icon { font-size: 48px; margin-bottom: 20px; }
.form-success-title {
font-family: ‘Cormorant Garamond’, serif;
font-size: 28px;
font-weight: 600;
font-style: italic;
color: var(–ink);
margin-bottom: 12px;
}
.form-success-text {
font-size: 13px;
color: var(–warm-gray);
line-height: 1.7;
}

/* ── CONTACT ── */
.contact-grid {
display: grid;
grid-template-columns: 1fr 1fr;
gap: 3px;
max-width: 800px;
margin: 0 auto;
}

.contact-block {
background: var(–white);
border: 1px solid var(–divider);
padding: 32px 28px;
}

.contact-label {
font-size: 9px;
font-weight: 500;
letter-spacing: 2.5px;
text-transform: uppercase;
color: var(–gold);
margin-bottom: 8px;
}

.contact-value {
font-family: ‘Cormorant Garamond’, serif;
font-size: 22px;
font-weight: 600;
color: var(–ink);
margin-bottom: 4px;
}

.contact-sub {
font-size: 12px;
color: var(–warm-gray);
}

/* ── FOOTER ── */
footer {
background: var(–ink);
padding: 48px;
text-align: center;
border-top: 1px solid rgba(184,134,11,0.2);
}

.footer-logo {
font-family: ‘Cormorant Garamond’, serif;
font-size: 28px;
font-weight: 300;
color: var(–cream);
margin-bottom: 12px;
}

.footer-logo span { font-style: italic; font-weight: 600; color: var(–gold-light); }

.footer-tagline {
font-size: 10px;
letter-spacing: 2.5px;
text-transform: uppercase;
color: rgba(245,240,232,0.35);
margin-bottom: 24px;
}

.footer-divider {
height: 1px;
background: linear-gradient(to right, transparent, rgba(184,134,11,0.3), transparent);
margin: 24px auto;
max-width: 400px;
}

.footer-copy {
font-size: 11px;
color: rgba(245,240,232,0.25);
}

/* ── ANIMATIONS ── */
@keyframes fadeUp {
from { opacity: 0; transform: translateY(20px); }
to { opacity: 1; transform: translateY(0); }
}

@keyframes scrollPulse {
0%, 100% { opacity: 0.4; transform: scaleY(1); }
50% { opacity: 1; transform: scaleY(1.1); }
}

/* ── RESPONSIVE ── */
@media (max-width: 900px) {
nav { padding: 0 24px; }
.nav-links { display: none; }
.services-grid, .addons-grid, .why-grid { grid-template-columns: 1fr; }
.contact-grid { grid-template-columns: 1fr; }
.form-grid { grid-template-columns: 1fr; }
.section { padding: 64px 24px; }
.hero { padding: 100px 24px 60px; }
}
</style>

