}

/* Form */
.form-grid {
display: grid;
grid-template-columns: 1fr 1fr;
gap: 16px;
margin-bottom: 16px;
}

.form-group {
display: flex;
flex-direction: column;
gap: 6px;
}

.form-group.full { grid-column: 1 / -1; }

.form-label {
font-size: 9px;
font-weight: 500;
letter-spacing: 2.5px;
text-transform: uppercase;
