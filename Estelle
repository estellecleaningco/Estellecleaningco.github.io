flex-shrink: 0;
}

.form-submit {
width: 100%;
background: var(–gold);
color: var(–ink);
border: none;
padding: 16px;
font-size: 11px;
font-weight: 600;
letter-spacing: 2.5px;
text-transform: uppercase;
cursor: pointer;
margin-top: 24px;
font-family: ‘DM Sans’, sans-serif;
