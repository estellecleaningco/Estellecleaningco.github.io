}

.checkbox-item {
display: flex;
align-items: center;
gap: 10px;
cursor: pointer;
font-size: 13px;
font-weight: 300;
color: var(–ink);
}

.checkbox-item input[type=“checkbox”] {
width: 16px;
height: 16px;
